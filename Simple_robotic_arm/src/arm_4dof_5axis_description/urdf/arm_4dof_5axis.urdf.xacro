<?xml version="1.0"?>
<robot name="arm_4dof_5axis" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_sim" default="true"/>

  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>
  <material name="steel_gray">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>

  <link name="world"/>

  <!-- Motor 1: base yaw (Z) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.12"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.35"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.07" ixy="0.0" ixz="0.0" iyy="0.07" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="120.0" velocity="1.8"/>
    <dynamics damping="0.6" friction="0.1"/>
  </joint>

  <!-- Motor 2: shoulder pitch (Y) -->
  <link name="link_2">
    <visual>
      <origin xyz="0.225 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.45"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.225 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.45"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.225 0 0" rpy="0 0 0"/>
      <mass value="4.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="1.8"/>
    <dynamics damping="0.6" friction="0.08"/>
  </joint>

  <!-- Motor 3: elbow pitch (Y) -->
  <link name="link_3">
    <visual>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.35"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.45 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="80.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.06"/>
  </joint>

  <!-- Motor 4: wrist rotate (X) -->
  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.14"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <mass value="1.6"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.6" upper="2.6" effort="45.0" velocity="2.5"/>
    <dynamics damping="0.3" friction="0.04"/>
  </joint>

  <!-- Motor 5: tool-axis rotate, mechanically coupled to Motor 4 -->
  <link name="link_5">
    <!-- Gripper base -->
    <visual>
      <origin xyz="0.04 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.026" length="0.08"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>
    <!-- Gripper palm -->
    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.07 0.05"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.026" length="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.07 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.0010" ixy="0.0" ixz="0.0" iyy="0.0035" iyz="0.0" izz="0.0035"/>
    </inertial>
  </link>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.012 0.025"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.012 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00004" ixy="0.0" ixz="0.0" iyy="0.00018" iyz="0.0" izz="0.00018"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="link_5"/>
    <child link="left_finger_link"/>
    <origin xyz="0.12 0.018 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.020" effort="40.0" velocity="0.06"/>
    <dynamics damping="15.0" friction="2.0"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.012 0.025"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.012 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00004" ixy="0.0" ixz="0.0" iyy="0.00018" iyz="0.0" izz="0.00018"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="link_5"/>
    <child link="right_finger_link"/>
    <origin xyz="0.12 -0.018 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.020" effort="40.0" velocity="0.06"/>
    <dynamics damping="15.0" friction="2.0"/>
    <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.6" upper="2.6" effort="30.0" velocity="2.5"/>
    <dynamics damping="0.6" friction="0.2"/>
    <mimic joint="joint_4" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="tool0"/>
  <joint name="tool0_fixed" type="fixed">
    <parent link="link_5"/>
    <child link="tool0"/>
    <origin xyz="0.23 0 0" rpy="0 0 0"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <param name="mimic">joint_4</param>
      <param name="multiplier">1.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_finger_joint">
      <param name="mimic">left_finger_joint</param>
      <param name="multiplier">1.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo reference="left_finger_link">
    <mu1>8.0</mu1>
    <mu2>8.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
  </gazebo>

  <gazebo reference="right_finger_link">
    <mu1>8.0</mu1>
    <mu2>8.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
  </gazebo>

  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>$(find arm_4dof_5axis_description)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
