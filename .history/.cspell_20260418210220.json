{
    "version": "0.2",
    "language": "en",
    // 允许全大写单词（适配 STM32 宏定义）
    "allowCompoundWords": true,
    "caseSensitive": false,
    // 自定义词典：覆盖 STM32 项目 99% 常用词汇
    "words": [
        // 系统与时钟
        "HAL_Init",
        "SystemClock_Config",
        "SysTick",
        "NVIC",
        "EXTI",
        "PWR",
        "RCC",
        "HSE",
        "HSI",
        "LSI",
        "LSE",
        "PLL",
        "PLLM",
        "PLLN",
        "PLLP",
        "PLLQ",
        "PLLR",
        "OSCILLATORTYPE",
        "HSESTATE",
        "PLLSTATE",
        "PLLSOURCE",
        "VOLTAGESCALING",
        "REGULATOR",
        "FLASH_LATENCY",
        // 外设名称
        "GPIO",
        "USART",
        "UART",
        "SPI",
        "I2C",
        "CAN",
        "FD",
        "ADC",
        "DAC",
        "TIM",
        "DMA",
        "WDG",
        "IWDG",
        "WWDG",
        "SDIO",
        "USB",
        "OTG",
        "ETH",
        "FMC",
        "QSPI",
        "SAI",
        "SPDIFRX",
        "DFSDM",
        "CRC",
        "RNG",
        "HASH",
        "CRYP",
        "LPTIM",
        "RTC",
        // HAL 库句柄与结构体
        "GPIO_InitTypeDef",
        "UART_HandleTypeDef",
        "SPI_HandleTypeDef",
        "I2C_HandleTypeDef",
        "CAN_HandleTypeDef",
        "TIM_HandleTypeDef",
        "ADC_HandleTypeDef",
        "DMA_HandleTypeDef",
        "RCC_OscInitTypeDef",
        "RCC_ClkInitTypeDef",
        "HAL_StatusTypeDef",
        // HAL 库常用函数
        "HAL_GPIO_Init",
        "HAL_GPIO_WritePin",
        "HAL_GPIO_TogglePin",
        "HAL_GPIO_ReadPin",
        "HAL_UART_Transmit",
        "HAL_UART_Receive",
        "HAL_UART_Transmit_IT",
        "HAL_UART_Receive_IT",
        "HAL_SPI_Transmit",
        "HAL_SPI_Receive",
        "HAL_I2C_Master_Transmit",
        "HAL_I2C_Master_Receive",
        "HAL_CAN_Start",
        "HAL_CAN_AddTxMessage",
        "HAL_TIM_Base_Start",
        "HAL_TIM_PWM_Start",
        "HAL_ADC_Start",
        "HAL_ADC_PollForConversion",
        "HAL_Delay",
        "HAL_GetTick",
        // 常用宏定义
        "GPIO_PIN",
        "GPIO_MODE",
        "GPIO_NOPULL",
        "GPIO_PULLUP",
        "GPIO_PULLDOWN",
        "GPIO_SPEED_FREQ",
        "GPIO_MODE_INPUT",
        "GPIO_MODE_OUTPUT_PP",
        "GPIO_MODE_AF_PP",
        "HAL_OK",
        "HAL_ERROR",
        "HAL_BUSY",
        "HAL_TIMEOUT",
        "ENABLE",
        "DISABLE",
        "SET",
        "RESET",
        "FLAG",
        "IT",
        // 项目与架构
        "main",
        "stm32",
        "STM32F",
        "STM32H",
        "STM32L",
        "STM32G",
        "STM32WB",
        "STM32WL",
        "CMSIS",
        "HAL",
        "LL",
        "BSP",
        "ARM",
        "Cortex",
        "M3",
        "M4",
        "M7",
        "M33",
        // FreeRTOS 相关
        "FreeRTOS",
        "CMSIS_RTOS",
        "task",
        "queue",
        "semaphore",
        "mutex",
        "osThreadDef",
        "osThreadCreate",
        "osMessagePut",
        "osMessageGet",
        "osSemaphoreCreate",
        "vTaskDelay",
        "xTaskCreate",
        "xQueueSend",
        "xQueueReceive",
        "cubemx",
        "libob",
        "huart",
        "Cplt"
    ],
    // 忽略 STM32CubeMX 自动生成的文件（无需检查拼写）
    "ignorePaths": [
        "**/Core/**/*.c",
        "**/Core/**/*.h",
        "**/Drivers/**/*",
        "**/Middlewares/**/*",
        "**/Debug/**/*",
        "**/Release/**/*",
        "**/Build/**/*",
        "**/CMakeFiles/**/*",
        "**/*.ioc",
        "**/startup_*.s",
        "**/system_stm32*.c",
        "**/*.ld",
        "**/*.s"
    ]
}